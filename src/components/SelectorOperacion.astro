---
/**
 * Selector Alquilar / Comprar del inicio. Sin JS funciona como formulario común
 * (radios + envío a /propiedades); con JS suma los chips de tipo y el contador en vivo.
 */
import type { Conteo } from '../lib/propiedades';
import { accionOperacion, nombreTipoPlural, type Operacion, type Tipo } from '../lib/formato';

interface Props {
  conteo: Conteo;
}

const { conteo } = Astro.props;
const operaciones: Operacion[] = ['alquiler', 'venta'];
const tipos: Tipo[] = ['casa', 'departamento', 'lote'];
const inicial: Operacion = conteo.alquiler.total > 0 ? 'alquiler' : 'venta';
const textoBoton = (n: number) => `Ver ${n} ${n === 1 ? 'propiedad' : 'propiedades'}`;
---

<form class="selector" action="/propiedades" method="get" data-selector data-conteo={JSON.stringify(conteo)}>
  <fieldset class="selector__segmento">
    <legend class="sr-only">¿Qué querés hacer?</legend>
    {
      operaciones.map((op) => (
        <>
          <input
            type="radio"
            id={`op-${op}`}
            name="operacion"
            value={op}
            checked={op === inicial}
            disabled={conteo[op].total === 0}
          />
          <label for={`op-${op}`}>
            {accionOperacion[op]}
            <span class="selector__cantidad">{conteo[op].total}</span>
          </label>
        </>
      ))
    }
  </fieldset>

  <div class="selector__tipos" role="group" aria-label="Tipo de propiedad (opcional)" data-tipos hidden>
    {
      tipos.map((t) => (
        <button type="button" class="chip" aria-pressed="false" data-tipo={t} hidden={!conteo[inicial].tipos[t]}>
          {nombreTipoPlural[t]}
        </button>
      ))
    }
  </div>
  <input type="hidden" name="tipo" value="" disabled data-tipo-input />

  <button type="submit" class="boton boton--primario boton--grande selector__enviar" data-enviar aria-live="polite">
    {textoBoton(conteo[inicial].total)}
  </button>
</form>

<script>
  import type { Conteo } from '../lib/propiedades';
  import type { Operacion, Tipo } from '../lib/formato';

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-selector]')) {
    const conteo = JSON.parse(form.dataset.conteo ?? '{}') as Conteo;
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-tipo]')];
    const inputTipo = form.querySelector<HTMLInputElement>('[data-tipo-input]')!;
    const enviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    form.querySelector<HTMLElement>('[data-tipos]')!.hidden = false;

    let tipo: Tipo | null = null;

    const actualizar = () => {
      const op = (new FormData(form).get('operacion') as Operacion | null) ?? 'alquiler';
      const tipos = conteo[op].tipos;
      if (tipo && !tipos[tipo]) tipo = null;
      for (const chip of chips) {
        const t = chip.dataset.tipo as Tipo;
        chip.hidden = !tipos[t];
        chip.setAttribute('aria-pressed', String(t === tipo));
      }
      inputTipo.value = tipo ?? '';
      inputTipo.disabled = !tipo;
      const n = tipo ? (tipos[tipo] ?? 0) : conteo[op].total;
      enviar.textContent = `Ver ${n} ${n === 1 ? 'propiedad' : 'propiedades'}`;
    };

    form.addEventListener('change', actualizar);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tipo as Tipo;
        tipo = tipo === t ? null : t;
        actualizar();
      });
    }
    actualizar();
  }
</script>

<style>
  .selector {
    display: grid;
    gap: var(--esp-4);
    max-width: 28rem;
  }

  .selector__segmento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3px;
    border: 0;
    background: var(--blanco);
    border-radius: calc(var(--radio) + 3px);
    box-shadow: inset 0 0 0 1px var(--borde-control);
  }

  .selector__segmento input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .selector__segmento label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    min-height: 3.25rem;
    border-radius: var(--radio);
    font-size: 1.125rem;
    font-weight: 650;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .selector__cantidad {
    min-width: 1.6rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--adobe-claro);
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    text-align: center;
  }

  .selector__segmento input:checked + label {
    background: var(--alamo);
    color: var(--blanco);
  }

  .selector__segmento input:checked + label .selector__cantidad {
    background: var(--alamo-oscuro);
  }

  .selector__segmento input:focus-visible + label {
    outline: 3px solid var(--foco);
    outline-offset: 2px;
  }

  .selector__segmento input:disabled + label {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .selector__tipos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }

  .selector__tipos[hidden] {
    display: none;
  }

  .chip {
    min-height: var(--tactil);
    padding: 0.4rem 1rem;
    background: transparent;
    border: 1px solid var(--borde-control);
    border-radius: 999px;
    font-weight: 550;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .chip[hidden] {
    display: none;
  }

  .chip:hover {
    background: var(--blanco);
  }

  .chip[aria-pressed='true'] {
    background: var(--piedra);
    border-color: var(--piedra);
    color: var(--blanco);
  }

  .selector__enviar {
    justify-self: start;
    min-width: 14rem;
  }

  @media (max-width: 30rem) {
    .selector__enviar {
      justify-self: stretch;
    }
  }
</style>
