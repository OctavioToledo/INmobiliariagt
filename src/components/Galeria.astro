---
/**
 * Carrusel con scroll-snap (swipe nativo), contador y flechas en desktop.
 * Tocar una foto abre el lightbox en esa misma foto.
 */
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import SinFotos from './SinFotos.astro';
import Lightbox from './Lightbox.astro';
import type { Foto } from '../lib/fotos';
import type { Tipo } from '../lib/formato';

interface Props {
  fotos: Foto[];
  tipo: Tipo;
}

const { fotos, tipo } = Astro.props;
const total = fotos.length;
---

{
  total === 0 ? (
    <div class="galeria galeria--vacia">
      <SinFotos tipo={tipo} />
    </div>
  ) : (
    <div class="galeria" data-galeria>
      <ul class="galeria__pista" data-pista aria-label={`Fotos, ${total} en total`} tabindex="0">
        {fotos.map((foto, i) => (
          <li class="galeria__item" data-indice={i}>
            <button type="button" class="galeria__ampliar" data-ampliar={i} aria-label={`Ampliar foto ${i + 1} de ${total}: ${foto.alt}`}>
              <Picture
                src={foto.src}
                alt={foto.alt}
                formats={['avif', 'webp']}
                widths={[400, 640, 900, 1200]}
                sizes="(min-width: 64rem) 46rem, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </button>
          </li>
        ))}
      </ul>
      {total > 1 && (
        <>
          <button type="button" class="galeria__flecha galeria__flecha--anterior" data-anterior aria-label="Foto anterior">
            <Icono nombre="anterior" tamano={24} />
          </button>
          <button type="button" class="galeria__flecha galeria__flecha--siguiente" data-siguiente aria-label="Foto siguiente">
            <Icono nombre="siguiente" tamano={24} />
          </button>
        </>
      )}
      <p class="galeria__contador" aria-live="polite">
        <span class="sr-only">Foto </span><span data-actual>1</span>{` / ${total}`}
      </p>
      <span class="galeria__lupa" aria-hidden="true"><Icono nombre="ampliar" tamano={18} /></span>
      <Lightbox fotos={fotos} />
    </div>
  )
}

<script>
  for (const galeria of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    const pista = galeria.querySelector<HTMLElement>('[data-pista]')!;
    const items = [...pista.querySelectorAll<HTMLElement>('[data-indice]')];
    const actual = galeria.querySelector<HTMLElement>('[data-actual]')!;
    const dialogo = galeria.querySelector<HTMLDialogElement>('[data-lightbox]');
    let indice = 0;

    const reducido = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ir = (i: number) => {
      const destino = items[Math.max(0, Math.min(items.length - 1, i))];
      pista.scrollTo({ left: destino?.offsetLeft ?? 0, behavior: reducido() ? 'auto' : 'smooth' });
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            indice = Number((e.target as HTMLElement).dataset.indice);
            actual.textContent = String(indice + 1);
          }
        }
      },
      { root: pista, threshold: 0.6 },
    );
    items.forEach((item) => observador.observe(item));

    galeria.querySelector('[data-anterior]')?.addEventListener('click', () => ir(indice - 1));
    galeria.querySelector('[data-siguiente]')?.addEventListener('click', () => ir(indice + 1));
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') ir(indice - 1);
      if (e.key === 'ArrowRight') ir(indice + 1);
    });

    for (const boton of galeria.querySelectorAll<HTMLElement>('[data-ampliar]')) {
      boton.addEventListener('click', () => {
        dialogo?.dispatchEvent(new CustomEvent('abrir', { detail: Number(boton.dataset.ampliar) }));
      });
    }
    // Al cerrar el lightbox, la galería queda en la última foto vista.
    dialogo?.addEventListener('vista', (e) => {
      const i = (e as CustomEvent<number>).detail;
      pista.scrollTo({ left: items[i]?.offsetLeft ?? 0, behavior: 'auto' });
    });
  }
</script>

<style>
  .galeria {
    position: relative;
    background: var(--adobe);
  }

  .galeria--vacia {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 48rem) {
    .galeria,
    .galeria--vacia {
      border-radius: var(--radio);
      overflow: hidden;
    }
  }

  .galeria__pista {
    display: flex;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .galeria__pista::-webkit-scrollbar {
    display: none;
  }

  .galeria__pista:focus-visible {
    outline-offset: -3px;
  }

  .galeria__item {
    flex: 0 0 100%;
    aspect-ratio: 4 / 3;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .galeria__ampliar {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .galeria__ampliar:focus-visible {
    outline-offset: -4px;
  }

  .galeria__ampliar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeria__contador,
  .galeria__lupa {
    position: absolute;
    bottom: var(--esp-3);
    padding: 0.2rem 0.6rem;
    background: rgb(34 39 42 / 0.78);
    color: var(--blanco);
    border-radius: var(--radio);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .galeria__contador {
    right: var(--esp-3);
  }

  .galeria__lupa {
    left: var(--esp-3);
    display: grid;
    place-items: center;
    padding: 0.35rem;
  }

  .galeria__flecha {
    position: absolute;
    top: 50%;
    display: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background: var(--blanco);
    border: 0;
    border-radius: 50%;
    color: var(--piedra);
    box-shadow: 0 1px 4px rgb(34 39 42 / 0.3);
    transform: translateY(-50%);
  }

  .galeria__flecha--anterior {
    left: var(--esp-3);
  }

  .galeria__flecha--siguiente {
    right: var(--esp-3);
  }

  @media (hover: hover) and (min-width: 48rem) {
    .galeria__flecha {
      display: grid;
    }
  }
</style>
