---
/** Mientras una propiedad no tiene fotos. Nada de fotos de stock. */
import Icono from './Icono.astro';
import type { Tipo } from '../lib/formato';

interface Props {
  tipo: Tipo;
  class?: string;
}

const { tipo, class: clase } = Astro.props;
---

<div class:list={['sin-fotos', clase]} role="img" aria-label="Fotos en camino">
  <Icono nombre={tipo} tamano={40} />
  <span>Fotos en camino</span>
</div>

<style>
  .sin-fotos {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--esp-2);
    width: 100%;
    height: 100%;
    background: var(--adobe);
    color: var(--piedra-suave);
    font-size: 0.9375rem;
    font-weight: 600;
  }
</style>
