---
import Logo from './Logo.astro';
import Icono from './Icono.astro';
import { linkWhatsApp, mensajeGeneral } from '../lib/whatsapp';

const links = [
  { texto: 'Alquileres', href: '/propiedades?operacion=alquiler' },
  { texto: 'Ventas', href: '/propiedades?operacion=venta' },
  { texto: 'Tasaciones', href: '/#propietarios' },
  { texto: 'Nosotros', href: '/#nosotros' },
  { texto: 'Contacto', href: '/#contacto' },
];
const wa = linkWhatsApp(mensajeGeneral);
---

<header class="header fondo-oscuro">
  <div class="contenedor header__fila">
    <Logo />
    <nav class="header__nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
      </ul>
    </nav>
    <div class="header__acciones">
      <a class="boton boton--whatsapp header__wa" href={wa} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" />
        <span class="header__wa-texto">WhatsApp</span>
        <span class="sr-only header__wa-sr">Escribinos por WhatsApp</span>
      </a>
      <button class="header__menu" type="button" aria-haspopup="dialog" aria-controls="menu-movil" data-abrir-menu>
        <Icono nombre="menu" tamano={24} />
        <span class="sr-only">Abrir menú</span>
      </button>
    </div>
  </div>
</header>

<dialog id="menu-movil" class="menu fondo-oscuro" aria-label="Menú">
  <div class="menu__cabecera">
    <Logo />
    <button type="button" class="header__menu" data-cerrar-menu>
      <Icono nombre="cerrar" tamano={24} />
      <span class="sr-only">Cerrar menú</span>
    </button>
  </div>
  <nav aria-label="Menú móvil">
    <ul>
      {links.map((l) => <li><a href={l.href} data-cerrar-menu>{l.texto}</a></li>)}
    </ul>
  </nav>
  <a class="boton boton--whatsapp boton--grande boton--ancho" href={wa} target="_blank" rel="noopener">
    <Icono nombre="whatsapp" />
    Escribinos por WhatsApp
  </a>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#menu-movil');
  document.querySelector('[data-abrir-menu]')?.addEventListener('click', () => menu?.showModal());
  menu?.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    // Cierra con los botones/links marcados o tocando el fondo.
    if (objetivo === menu || objetivo.closest('[data-cerrar-menu]')) menu.close();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--alamo-oscuro);
  }

  .header__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-4);
    min-height: var(--alto-header);
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--esp-1);
    padding: 0;
    list-style: none;
  }

  .header__nav a,
  .menu a:not(.boton) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tactil);
    padding-inline: var(--esp-3);
    font-weight: 550;
    text-decoration: none;
    border-radius: var(--radio);
  }

  .header__nav a:hover {
    background: var(--alamo-oscuro);
  }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: var(--esp-2);
  }

  .header__wa {
    width: var(--tactil);
    padding: 0;
  }

  .header__wa-texto {
    display: none;
  }

  .header__menu {
    display: grid;
    place-items: center;
    width: var(--tactil);
    height: var(--tactil);
    padding: 0;
    background: transparent;
    border: 1px solid rgb(237 240 238 / 0.4);
    border-radius: var(--radio);
    color: var(--blanco);
  }

  @media (min-width: 60rem) {
    .header__nav {
      display: block;
    }

    .header__menu {
      display: none;
    }

    .header__wa {
      width: auto;
      padding-inline: 1rem;
    }

    .header__wa-texto {
      display: inline;
    }

    .header__wa-sr {
      display: none;
    }
  }

  .menu {
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0 var(--gutter) calc(var(--esp-5) + env(safe-area-inset-bottom));
    border: 0;
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background: rgb(34 39 42 / 0.5);
  }

  .menu__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--alto-header);
  }

  .menu nav {
    flex: 1;
    padding-block: var(--esp-5);
  }

  .menu ul {
    display: grid;
    gap: var(--esp-1);
    padding: 0;
    list-style: none;
  }

  .menu a:not(.boton) {
    width: 100%;
    min-height: 3.25rem;
    padding-inline: 0;
    font-size: var(--t2);
    font-weight: 700;
    font-stretch: var(--ancho-titulo);
    border-bottom: 1px solid rgb(237 240 238 / 0.15);
    border-radius: 0;
  }
</style>
