---
import '../styles/global.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { sitio } from '../config/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta o URL de la imagen para compartir (1200×630). */
  imagenOg?: string;
  altImagenOg?: string;
  tipoOg?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** En la ficha el botón flotante se oculta en mobile (lo reemplaza la barra de consulta). */
  flotanteSoloDesktop?: boolean;
  noindex?: boolean;
}

const {
  titulo,
  descripcion,
  imagenOg = '/og/inicio.jpg',
  altImagenOg = sitio.nombre,
  tipoOg = 'website',
  jsonLd = [],
  flotanteSoloDesktop = false,
  noindex = false,
} = Astro.props;

// Con build.format 'file' el pathname del build termina en .html; la URL pública no.
const ruta = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = new URL(ruta || '/', Astro.site);
const og = new URL(imagenOg, Astro.site);
const fuente = `@font-face{font-family:'Archivo Variable';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivo}) format('woff2-variations'),url(${archivo}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---

<!doctype html>
<html lang="es-AR" data-dev={import.meta.env.DEV ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2e4a3b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fuente} />

    <meta property="og:type" content={tipoOg} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altImagenOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={og} />

    {jsonLd.map((datos) => <script type="application/ld+json" is:inline set:html={JSON.stringify(datos)} />)}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <BotonWhatsApp ocultarEnMobile={flotanteSoloDesktop} />
    <slot name="final" />
  </body>
</html>
